{
  "name": "tactix-tactical",
  "productName": "GTA 5 Mod Manager",
  "version": "1.0.0",
  "description": "GTA V Enhanced LSPDFR manager with a separate Online install",
  "main": "src/main.js",
  "author": "GTA 5 Mod Manager",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/write-app-icon.js",
    "desktop-shortcut": "node scripts/write-app-icon.js && node scripts/create-desktop-shortcut.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "validate": "node scripts/validate-smart-install.js",
    "verify": "node --test \"tests/**/*.test.js\" && node scripts/verify-launch.js",
    "verify:rpf-readonly": "node scripts/verify-rpf-readonly.js",
    "verify:session-monitor": "node scripts/verify-session-monitor.js",
    "verify:workshop-api": "node scripts/verify-workshop-api.js",
    "pack": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.tactix.gta5modmanager",
    "productName": "GTA 5 Mod Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "**/7zip-bin/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "GTA 5 Mod Manager.exe"
    }
  },
  "dependencies": {
    "7zip-bin": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^36.5.0",
    "electron-builder": "^26.15.3"
  }
}
